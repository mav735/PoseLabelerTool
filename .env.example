# Parent directory holding one folder per dataset (images/, labels/, …)
DATASETS_ROOT=/Users/alexander/data/datasets
# Directory holding .pt model files
MODELS_DIR=/Users/alexander/data/models
APP_PORT=8080
# Name your existing single-dataset database is backfilled to on the first boot after
# upgrading. Only matters that once; ignored on every later boot.
# MIGRATE_DEFAULT_DATASET=default
# HuggingFace token, for downloading datasets and models from private repos.
# Leave unset to run with local datasets only.
# HF_TOKEN=hf_...
